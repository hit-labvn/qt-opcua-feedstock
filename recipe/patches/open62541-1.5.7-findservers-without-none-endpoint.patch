From: Hao Truong <haotruong@hit-lab.vn>
Subject: [PATCH] open62541: Allow FindServers without a SecurityPolicy#None endpoint

UA_Client_findServers() and UA_Client_getEndpoints() open a SecureChannel
without a Session (connectSecureChannel), but connectActivity() still ran
GetEndpoints and required an endpoint usable with the client's
SecurityPolicies. A client with only SecurityPolicy#None, as used by
QOpcUaClient::findServers(), then failed with BadIdentityTokenRejected
against servers that offer only secured endpoints but allow discovery over
a None SecureChannel.

Mark discovery-only connections and skip the endpoint selection for them.

Backport of https://github.com/open62541/open62541/pull/8554 (1.5) to the
open62541 1.5.7 amalgamation bundled by qtopcua.
---
diff --git a/src/3rdparty/open62541/open62541.c b/src/3rdparty/open62541/open62541.c
index e3ce48f..e59ddb5 100644
--- a/src/3rdparty/open62541/open62541.c
+++ b/src/3rdparty/open62541/open62541.c
@@ -5018,6 +5018,7 @@ struct UA_Client {
 
     UA_Boolean findServersHandshake;   /* Ongoing FindServers */
     UA_Boolean endpointsHandshake;     /* Ongoing GetEndpoints */
+    UA_Boolean discoveryOnly;          /* Skip endpoint selection */
     UA_Boolean namespacesHandshake;    /* Ongoing Namespaces read */
     UA_Boolean haveNamespaces;         /* Do we have the namespaces? */
 
@@ -93946,14 +93947,18 @@ isFullyConnected(UA_Client *client) {
     if(client->channel.state != UA_SECURECHANNELSTATE_OPEN)
         return false;
 
-    /* GetEndpoints handshake ongoing or not yet done */
-    if(client->endpointsHandshake || endpointUnconfigured(&client->endpoint))
-        return false;
-
     /* FindServers handshake ongoing or not yet done */
     if(client->findServersHandshake || client->discoveryUrl.length == 0)
         return false;
 
+    /* Discovery services need neither an endpoint nor a Session */
+    if(client->discoveryOnly)
+        return true;
+
+    /* GetEndpoints handshake ongoing or not yet done */
+    if(client->endpointsHandshake || endpointUnconfigured(&client->endpoint))
+        return false;
+
     if(!client->config.noSession) {
         /* No Session, but is required */
         if(client->sessionState != UA_SESSIONSTATE_ACTIVATED)
@@ -95798,6 +95803,10 @@ connectActivity(UA_Client *client) {
         return;
     }
 
+    /* Discovery services can be called without selecting an endpoint */
+    if(client->discoveryOnly)
+        return;
+
     /* GetEndpoints to identify the remote side and/or reset the SecureChannel
      * with encryption */
     if(endpointUnconfigured(&client->endpoint)) {
@@ -96249,6 +96258,7 @@ connectSecureChannel(UA_Client *client, const char *endpointUrl) {
     cc->noSession = true;
     UA_String_clear(&cc->endpointUrl);
     cc->endpointUrl = UA_STRING_ALLOC(endpointUrl);
+    client->discoveryOnly = true;
     return connectInternal(client, false);
 }
 
@@ -96262,6 +96272,7 @@ __UA_Client_connect(UA_Client *client, UA_Boolean async, const char *endpointUrl
         cc->endpointUrl = UA_STRING_ALLOC(endpointUrl);
     }
 
+    client->discoveryOnly = false;
     connectInternal(client, async);
 
     unlockClient(client);
@@ -96518,6 +96529,7 @@ UA_Client_startListeningForReverseConnect(UA_Client *client,
     UA_StatusCode res = UA_STATUSCODE_BADINTERNALERROR;
 
     client->connectStatus = UA_STATUSCODE_GOOD;
+    client->discoveryOnly = false;
     client->channel.renewState = UA_SECURECHANNELRENEWSTATE_NORMAL;
 
     UA_SecureChannel_init(&client->channel);
